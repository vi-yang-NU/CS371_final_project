(in-microtheory HarryPotterIngredientsMt)
(isa HarryPotterIngredientsMt Microtheory)
(comment HarryPotterIngredientsMt
  "Microtheory that has the ontology/facts about ingredients")

;; make a new collection of all ingredients in HP world
(isa PotionIngredients Collection)
(genls PotionIngredients FoodOrDrinkOrIngredient) ;; existing collection found in KB


(isa PotionAttempt Collection)
;; define hasIngredient predicate

(isa hasIngredient BinaryPredicate)
(arg1Isa hasIngredient PotionAttempt) 
(arg2Isa hasIngredient PotionIngredients)


;; list of ingredients 
(isa SnakeFangs PotionIngredients)
(isa HornedSlugs PotionIngredients)
(isa PorcupineQuills PotionIngredients)
(isa LacewingFly PotionIngredients)
(isa Leeche PotionIngredients)
(isa BicornHorn PotionIngredients)
(isa Knotgrass PotionIngredients)
(isa Fluxweed PotionIngredients)
(isa BoomslangSkin PotionIngredients)
(isa Shrivelfig PotionIngredients)
(isa Caterpillars PotionIngredients)
(isa ratSpleens PotionIngredients)
(isa leechJuice PotionIngredients)
(isa SopophorousBean PotionIngredients)
(isa waterAndSalt PotionIngredients)
(isa wormwood PotionIngredients)
(isa valerianroots_water PotionIngredients)
(isa sopophorusBeanJuice PotionIngredients)
(isa powdered_root_Asphodel PotionIngredients)
(isa powderedMoonstone PotionIngredients)
(isa helleboreSyrup PotionIngredients)
(isa stewedMandrake PotionIngredients)
(isa powderedUnicornHorn PotionIngredients)
(isa PorcupineQuills PotionIngredients)


;; adding CureBoils potion ingredients

(<== (hasCorrectIngredients Cure_Boils_Recipee ?attempt)
    (hasIngredient ?attempt SnakeFangs)
    (hasIngredient ?attempt HornedSlugs)
    (hasIngredient ?attempt PorcupineQuills))

;; adding polyjuice potion ingredients 

(<== (hasCorrectIngredients Polyjuice_Recipee ?attempt)
    (hasIngredient ?attempt LacewingFly)
    (hasIngredient ?attempt Leeche)
    (hasIngredient ?attempt BicornHorn)
    (hasIngredient ?attempt Knotgrass)
    (hasIngredient ?attempt Fluxweed)
    (hasIngredient ?attempt BoomslangSkin))

(<== (hasCorrectIngredients ShrinkingPotion_Recipee ?attempt)
    (hasIngredient ?attempt Shrivelfig)
    (hasIngredient ?attempt Caterpillars)
    (hasIngredient ?attempt ratSpleens)
    (hasIngredient ?attempt leechJuice)
    )

(<== (hasCorrectIngredients draughtOfLDP_Recipee ?attempt)
    (hasIngredient ?attempt SopophorousBean )
    (hasIngredient ?attempt waterAndSalt )
    (hasIngredient ?attempt wormwood )
    (hasIngredient ?attempt valerianroots_water )
    (hasIngredient ?attempt sopophorusBeanJuice )
    (hasIngredient ?attempt powdered_root_Asphodel )
    )

(<== (hasCorrectIngredients draughtofP_Recipee ?attempt)
    (hasIngredient ?attempt powderedMoonstone )
    (hasIngredient ?attempt helleboreSyrup )
    (hasIngredient ?attempt stewedMandrake )
    (hasIngredient ?attempt powderedUnicornHorn )
    (hasIngredient ?attempt PorcupineQuills )) 

;; ingredient hazzards 

(isa HazardAction Collection)
(isa heat HazardAction)


(isa HazardIngredient Collection)
(isa PorcupineQuills HazardIngredient)
(isa Shrivelfig HazardIngredient)

(isa HazardTools Collection)
(isa cauldron HazardTools)


(<== (isHazard ?ingredient ?action ?tool)
    (isa ?ingredient HazardIngredient)
    (isa ?action HazardAction )
    (isa ?tool HazardTools )
)


(isa drinker Collection)

;; Define potion effect validity 
;; (<== (hasPotionEffect ?PotionAttempt ?drinker) 
;;     (isa ?drinker valid) 
;;     () 
;; )
;; (isa hasPotionEffect Predicate)

(isa hasBoils Predicate)
(arity hasBoils 1)
;; (arg1Isa hasBoils drinker)

(isa hasShrunk Predicate)
(arity hasShrunk 0)

(isa isAwake Predicate)
(arity isAwake 1)

(isa atPeace Predicate)
(arity atPeace 0)

(<== (hasPotionEffect Cure_Boils_Potion ?attempt ?drinker)
    (hasCorrectIngredients Cure_Boils_Recipee ?attempt) ;; return true if ingredients are correct 
    (hasBoils ?drinker) 
    )
(<== (hasPotionEffect Polyjuice_Potion ?attempt ?drinker ?drinker2)
    (hasCorrectIngredients Polyjuice_Recipee ?attempt) ;; return true if ingredients are correct 
    (different ?drinker ?drinker2) 
    ;; additional stuff here 
    )
(<== (hasPotionEffect Shrinking_Potion ?attempt ?drinker)
    (hasCorrectIngredients ShrinkingPotion_Recipee ?attempt) ;; return true if ingredients are correct 
    (hasShrunk ?drinker)
    )
(<== (hasPotionEffect draughtOfLDP_Potion ?attempt ?drinker)
    (hasCorrectIngredients draughtOfLDP_Recipee ?attempt) ;; return true if ingredients are correct 
    (isAwake ?drinker)
    )
(<== (hasPotionEffect draughtofP_Potion ?attempt ?drinker)
    (hasCorrectIngredients draughtofP_Recipee ?attempt) ;; return true if ingredients are correct 
    (atPeace ?drinker)
    )